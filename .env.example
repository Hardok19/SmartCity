# Copiar a .env y ajustar si cambian las credenciales del docker-compose.yml.
# .env NO se sube al repositorio.

# PostgreSQL (desde el anfitrión)
PG_HOST=localhost
PG_PORT=5433
PG_DB=smartcity_db
PG_USER=smartcity
PG_PASSWORD=smartcity123

# MongoDB (desde el anfitrión: localhost)
MONGO_URI=mongodb://smartcity:smartcity123@localhost:27017/smartcity_db?authSource=admin
MONGO_DB=smartcity_db

# MongoDB para los jobs Spark que corren DENTRO de Docker (host "mongo")
MONGO_URI_SPARK=mongodb://smartcity:smartcity123@mongo:27017/smartcity_db?authSource=admin

# HDFS
HDFS_WEB=http://localhost:9870
HDFS_USER=root

# Contenedores
CONTENEDOR_NAMENODE=smartcity_namenode
CONTENEDOR_SPARK=smartcity_spark_master
SPARK_UI=http://localhost:8080

# OpenAQ (descarga de datos, scripts/descargar_openaq.py)
OPENAQ_API_KEY=
